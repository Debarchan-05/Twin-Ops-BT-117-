# TwinOps Digital Twin Framework Configuration Template
PROJECT_NAME="TwinOps Digital Twin Framework"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite local instance or PostgreSQL)
DATABASE_URL="sqlite:///./twinops.db"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Simulation Engine Parameters
SIMULATION_INTERVAL_SECONDS=2.0
SIMULATION_AUTOSTART=true
SIMULATION_RANDOM_SEED=42

# Health Engine Classification Boundaries
HEALTH_THRESHOLD_HEALTHY=80.0
HEALTH_THRESHOLD_DEGRADED=50.0
